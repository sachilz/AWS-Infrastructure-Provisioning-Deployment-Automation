# Example Terraform Variables
# Copy this file to `terraform.tfvars` and customize with your own local values.
# NEVER commit `terraform.tfvars` containing secrets or real private keys.

aws_region        = "us-east-1"
project_name      = "aws-devops-automation"
instance_type     = "t3.micro"
ssh_allowed_cidr  = "YOUR_PUBLIC_IP/32"       # Run: curl -s https://checkip.amazonaws.com to find your IP
public_key_path   = "~/.ssh/id_rsa.pub"      # Path to your local SSH public key
